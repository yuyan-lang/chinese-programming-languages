      "scheduling": [
        {
          "text": "thread.c维护每CPU就绪位图和运行队列权重，依据虚拟运行时间与deadline选取任务，通过process_activate和switch_to切换。timer及重调度IPI路径调用调度器。",
          "evidence_level": "源码可见",
          "source_ids": [
            "cz13",
            "cz14"
          ]
        },
        {
          "text": "固定SMP代码通过INIT/SIPI唤醒AP，建立每CPU描述符、TSS和idle任务，并切入任务上下文；完整多核运行行为待核实。",
          "evidence_level": "源码可见",
          "source_ids": [
