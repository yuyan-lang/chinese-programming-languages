      ],
      "scheduling": [
        {
          "text": "单组父子协程上下文保存x19—x30与sp；读取输入或图形提交可让出执行。EL0窗口通过屏蔽IRQ/FIQ及临时VBAR交接运行子程序。抢占式调度与多进程并行覆盖待核实。",
          "evidence_level": "源码可见",
          "source_ids": [
            "hd12",
            "hd14"
          ]
        }
      ],
      "userspace": [
        {
          "text": "ELF64装载器核对AArch64、ET_EXEC／ET_DYN并应用RELATIVE／ABS64重定位。启动与syscall包装分别提供EL1函数指针和EL0 SVC路径；EL0自检失败可回到EL1。shell的cmd_open与直接exec／协程入口按各自路径运行。Linux编号用于部分接口。getpid固定1，getuid／geteuid固定0，brk返回常数；完整Linux ABI覆盖待核实。",
          "evidence_level": "源码可见",
          "source_ids": [
