      "memory": [
        {
          "text": "ELF映像、用户栈、页表及缓冲区经UEFI AllocatePages／AllocatePool取得。独立子页表克隆与ASID代码可见；g_el0_phaseb默认0，按该开关控制协程子程序路径。隔离覆盖与安全性待独立验证。",
          "evidence_level": "源码可见",
          "source_ids": [
            "hd12",
            "hd13"
          ]
