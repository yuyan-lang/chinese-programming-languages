    "capabilities": {
      "boot": [
        {
          "text": "@boot入口生成可引导内核镜像；README说明BIOS将首扇区载入，内核占后续扇区。引导生成器属于配套lgc，具体二进制版本绑定待核实。",
          "evidence_level": "源码可见与作者声明",
          "source_ids": [
            "lo7",
            "lo8",
            "lo19",
            "lgc-boot-example"
          ]
        }
      ],
      "scheduling": [
        {
          "text": "core.lg设置MAXPROC=8，维护FREE/READY/RUN/ZOMBIE状态、每任务CR3与内核栈。pick_next轮转寻找READY任务，IRQ0分发进入sched_irq并切换寄存器帧和页表。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo10"
          ]
        }
      ],
      "memory": [
        {
          "text": "mm.lg从0x1000000至0x4000000按4KiB递增分配页帧，为地址空间创建PML4/PDPT/PD/PT并按缺页映射用户页。core.lg设置页表权限位；完整内存隔离与W^X保证待独立验证。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo9",
            "lo13",
            "lo29"
          ]
        }
      ],
      "filesystem": [
        {
          "text": "fs.lg提供32个RAMFS文件槽，每个新文件预留1MiB；ata.lg以PIO端口读写扇区，shell的save命令调用ata_write及flush。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo15",
            "lo16",
            "lo18"
          ]
        }
      ],
      "drivers": [
        {
          "text": "VGA文本缓冲位于0xB8000；键盘代码轮询0x60/0x64并译码，串口使用COM1，定时中断使用PIC/PIT。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo9",
            "lo17"
          ]
        }
      ],
      "applications": [
        {
          "text": "ELF加载器读取64位入口与program headers，对PT_LOAD段复制文件内容并清零BSS。shell创建地址空间、初始栈和用户进程，提供exec/bg/ps。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo14",
            "lo18"
          ]
        },
        {
          "text": "系统调用分发覆盖read/write/open/close、部分stat、mmap/brk等Linux x86-64编号。mprotect/munmap等编号直接返回0，未知编号返回-38。具体应用兼容性按已实现接口逐项核验。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo11",
            "lo12"
          ]
        }
      ],
      "self_hosting": [
        {
          "text": "测试脚本向客体发送exec lgc.elf os.lg os.bin及save命令，随后由宿主提取镜像、复制预载文件区并再次启动QEMU，再运行hello_c和a.lg编译测试。该脚本记录内核自举往返设计。",
          "evidence_level": "源码可见",
          "source_ids": [
            "lo20"
          ]
        },
        {
          "text": "README将运行自举版lgc、静态glibc C程序及自举往返列为完成项。",
          "evidence_level": "作者声明",
          "source_ids": [
            "lo7"
          ]
        }
      ]
    },
