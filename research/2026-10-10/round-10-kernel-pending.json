      }
    ],
    "capabilities": {
      "boot": [
        {
          "text": "Multiboot魔数、16KiB内核栈与kernel_main调用位于boot.asm；C入口读取Multiboot内存、模块和framebuffer信息。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo10",
            "vo11"
          ]
        },
        {
          "text": "官网当前产品说明记录Legacy BIOS、CLI命令行与基础网络；网站所述阶段与固定仓库快照对应关系待核实。",
          "evidence_level": "作者声明",
          "source_ids": [
            "vo6"
          ]
        }
      ],
      "scheduling": [
        {
          "text": "task.c保存32个任务槽、4KiB任务栈和就绪链表；task_yield按链表轮转并切换ESP。PIT回调累加tick_count。抢占调度、退出任务回收和切换正确性继续待核实。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo13",
            "vo14"
          ]
        }
      ],
      "memory": [
        {
          "text": "物理页分配采用4KiB页位图，跟踪上限32MiB；分页模块建立0—32MiB恒等映射并设置CR3及CR0分页位。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo15",
            "vo16"
          ]
        },
        {
          "text": "堆分配采用first-fit、块分裂和相邻空闲块合并；配置为16MiB上限、1MiB初始空间，按1MiB扩展。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo17",
            "vo18"
          ]
        }
      ],
      "filesystem": [
        {
          "text": "initrd.c解析ustar内存盘，建立最多64项文件表，提供按名称查找、读取及列表接口。持久化磁盘文件系统与设备读写路径继续待核实。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo19"
          ]
        }
      ],
      "drivers": [
        {
          "text": "键盘与鼠标源码分别注册IRQ1与IRQ12，处理PS/2扫描码和三字节鼠标包；PIT注册IRQ0。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo14",
            "vo21",
            "vo22"
          ]
        },
        {
          "text": "图形驱动接受Multiboot帧缓冲参数，并包含BGA寄存器与PCI BAR0查找函数，设置1024×768×32bpp路径。",
          "evidence_level": "源码可见",
          "source_ids": [
            "vo20"
          ]
        }
      ]
    },
    "implementation_languages": [
      {
        "text": "固定内核、驱动与库以C实现，启动、中断和上下文入口采用NASM汇编；build.sh配置C11 freestanding。",
        "evidence_level": "源码可见",
