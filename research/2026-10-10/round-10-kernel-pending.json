    "project_relationships": [
      {
        "text": "README使用VergeOS Open项目名及VoidOS工作目录；固定源码、输出文件和内核banner沿用VoidOS v0.2。",
        "evidence_level": "作者声明",
        "source_ids": [
          "vo3",
          "vo8",
          "vo11"
        ]
      },
      {
        "text": "构建与运行脚本引用i686-elf工具链、NASM、QEMU；Windows工具配置指向lordmilko/i686-elf-tools 13.2.0与NASM 2.16.03，GRUB用于可选ISO构建。完整工具与分发包许可范围待核实。",
        "evidence_level": "源码可见",
        "source_ids": [
          "vo12",
          "vo27",
          "vo28"
        ]
      },
      {
        "text": "ELF32加载器从initrd读取PT_LOAD段，映射权限参数为supervisor；PE32加载器解析i386文件并提供有限Win32桩。Shell将加载入口交给task_create和task_yield。完整用户态隔离、Windows应用兼容及程序运行继续待核实。",
        "evidence_level": "源码可见",
        "source_ids": [
          "vo23",
